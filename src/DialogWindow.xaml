<Window x:Class="Iconic.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iconic" Width="430" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" Foreground="White"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#2E000000" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="8"
            Padding="26,24,24,20" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="MessageText" Margin="0,10,0,0" FontSize="13" Foreground="#CCFFFFFF"
                       TextWrapping="Wrap" LineHeight="19"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource GlassButton}" MinWidth="96"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" MinWidth="96"
                        Margin="10,0,0,0" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
