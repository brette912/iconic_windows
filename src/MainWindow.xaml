<Window x:Class="Iconic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Iconic"
        Title="Iconic" Icon="/Assets/Iconic.ico"
        Width="1000" Height="660" MinWidth="560" MinHeight="380"
        Background="Transparent" Foreground="White"
        FontFamily="{StaticResource UiFont}"
        ResizeMode="CanResize" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="8"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- One icon tile -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:AppItem}">
            <Border x:Name="Tile" Width="100" Height="110" Margin="3" CornerRadius="14"
                    AllowDrop="True" RenderTransformOrigin="0.5,0.5" ToolTip="{Binding Name}"
                    PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tile_PreviewMouseMove"
                    MouseLeftButtonUp="Tile_MouseLeftButtonUp"
                    MouseRightButtonUp="Tile_MouseRightButtonUp"
                    DragOver="Tile_DragOver" Drop="Tile_Drop">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1CFFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.RenderTransform>
                    <ScaleTransform/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.07" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.07" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <StackPanel Margin="6,11,6,4">
                    <Grid Width="56" Height="56">
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="Black"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                   Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="12" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="32" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVis}}"/>
                        <TextBox Style="{StaticResource EditBox}" TextAlignment="Center"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                 IsVisibleChanged="EditBox_IsVisibleChanged"
                                 PreviewKeyDown="EditBox_PreviewKeyDown"
                                 LostKeyboardFocus="EditBox_LostKeyboardFocus"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One group card -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type local:AppGroup}">
            <Grid Margin="4,6">
            <Border Padding="16,12,16,14" CornerRadius="18"
                    Background="#12FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1"
                    AllowDrop="True" DragOver="Group_DragOver" DragLeave="Group_DragLeave" Drop="Group_Drop">
                <StackPanel>
                    <Grid Height="30" Background="Transparent" Cursor="Hand"
                          MouseRightButtonUp="GroupHeader_MouseRightButtonUp"
                          PreviewMouseLeftButtonDown="GroupHeader_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="GroupHeader_PreviewMouseMove">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" Cursor="IBeam"
                                   ToolTip="Double-click to rename"
                                   MouseLeftButtonDown="GroupName_MouseLeftButtonDown"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVis}}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource EditBox}" FontSize="14" MinWidth="180"
                                 Margin="6,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                 IsVisibleChanged="EditBox_IsVisibleChanged"
                                 PreviewKeyDown="EditBox_PreviewKeyDown"
                                 LostKeyboardFocus="EditBox_LostKeyboardFocus"/>

                        <Border Grid.Column="2" CornerRadius="8" Background="#1AFFFFFF" Padding="7,1"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Items.Count}" FontSize="11" Foreground="#B3FFFFFF"/>
                        </Border>

                        <Button Grid.Column="4" Style="{StaticResource GhostButton}" Click="Collapse_Click"
                                ToolTip="Collapse or expand">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE70D;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                <Setter Property="Text" Value="&#xE76C;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <Grid Margin="0,8,0,0" Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Drag icons here" Foreground="#59FFFFFF" FontSize="12.5" Margin="4,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="{Binding IsShown, Converter={StaticResource BoolToVis}}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Blue line showing where a dragged group will land -->
            <Border Height="3" CornerRadius="1.5" Background="#0A84FF" VerticalAlignment="Top"
                    Margin="16,-5,16,0" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DropHint}" Value="Top">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Border Height="3" CornerRadius="1.5" Background="#0A84FF" VerticalAlignment="Bottom"
                    Margin="16,0,16,-5" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DropHint}" Value="Bottom">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="#2E000000" BorderBrush="#24FFFFFF" BorderThickness="1"
            CornerRadius="8" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Background="Transparent" Padding="22,18,18,12"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid x:Name="TopBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Iconic.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Iconic" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CountText" Foreground="#80FFFFFF" FontSize="12.5" Margin="10,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBox x:Name="Search" Grid.Column="1" Width="320" Height="34"
                         Style="{StaticResource SearchBox}"
                         TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PinButton" Style="{StaticResource GlassButton}" Padding="10,6"
                            Margin="0,0,8,0" Click="Pin_Click">
                        <TextBlock x:Name="PinGlyph" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource GlassButton}" Click="NewGroup_Click" ToolTip="New group">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Group" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource GlassButton}" Margin="8,0,0,0"
                            Padding="10,6" Click="More_Click" ToolTip="More">
                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
            </Border>


            <!-- Groups -->
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled" Padding="18,0,18,18" Focusable="False">
                <ItemsControl x:Name="GroupsList" ItemTemplate="{StaticResource GroupTemplate}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding IsShown, Converter={StaticResource BoolToVis}}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
